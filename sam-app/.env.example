# .env.example — Environment variables for local development
# ===========================================================
# Copy this file to .env and fill in your real values.
# For sam local: copy to sam-app/env.json format (see README §Local Dev).
# NEVER commit .env or env.json to version control.

# ── LLM ────────────────────────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-REPLACE_ME

# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Which provider to use: "openai" | "anthropic"
LLM_PROVIDER=openai

# Model name
# OpenAI options:   gpt-4o | gpt-4o-mini | gpt-4-turbo
# Anthropic options: claude-3-5-sonnet-20241022 | claude-3-haiku-20240307
LLM_MODEL=gpt-4o

# ── ElevenLabs TTS ─────────────────────────────────────────────────────────
# Get from: https://elevenlabs.io/app/profile/api-key (free 10k chars/month)
ELEVENLABS_API_KEY=REPLACE_ME

# Default voice ID. Browse free voices: https://elevenlabs.io/voice-library
# Rachel (female, calm):  21m00Tcm4TlvDq8ikWAM
# Adam  (male, neutral):  pNInz6obpgDQGcFmaJgB
# Bella (female, warm):   EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── D-ID Video Avatars ──────────────────────────────────────────────────────
# Get from: https://studio.d-id.com (free 5 min/month)
# Format:  "Basic <base64(your@email.com:your_api_key)>"
# Encode:  python -c "import base64; print(base64.b64encode(b'email:key').decode())"
DID_API_KEY=Basic REPLACE_ME_WITH_BASE64_ENCODED_EMAIL_COLON_KEY

# Default presenter/avatar ID.
# Stock avatars:  amy-jcu8MFXSuU | josh-7b9... | anna-costume1...
# YOUR CUSTOM AVATAR: after creating at https://studio.d-id.com/agents
#   - Go to Agents → Create Agent → choose "Upload Photo"
#   - Upload your photo → save → copy the presenter_id from the URL
CUSTOM_AVATAR_ID=amy-jcu8MFXSuU
DID_PRESENTER_ID=amy-jcu8MFXSuU

# (Optional) Custom driver video URL — controls head/body movement
# Leave blank to use D-ID's default driver
DID_DRIVER_URL=

# ── App ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
CORS_ORIGIN=*

# ── Frontend (Vite / plain HTML) ────────────────────────────────────────────
# After `sam local start-api`, set this to http://localhost:3001
# After `sam deploy`, set this to the ApiBaseURL output from CloudFormation
VITE_API_BASE_URL=http://localhost:3001
