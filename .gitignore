# Dynamic Video AI Agent Platform — .gitignore
# =============================================

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
.Python
.python-version
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/
.env
.direnv/

# ── Secrets / credentials — NEVER COMMIT THESE ───────────────────────────────
*.env
env.json
sam-app/env.json
.secrets
.secret
secrets.json
credentials.json

# ── AWS SAM build artifacts ───────────────────────────────────────────────────
.aws-sam/
samconfig-local.toml

# ── Lambda Layer installed packages (installed by pip, not tracked in git) ───
sam-app/layers/dependencies/python/

# ── AWS ───────────────────────────────────────────────────────────────────────
.aws/
aws-exports.js

# ── Node.js (if you add Vite later) ──────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
.vite/
.next/
out/

# ── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
ehthumbs.db

# ── IDEs ─────────────────────────────────────────────────────────────────────
.idea/
*.iml
.vscode/settings.json
.vscode/launch.json
*.swp
*.swo
*~
.project
.classpath
.settings/

# Keep VS Code extension recommendations
!.vscode/extensions.json

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
*.log
*.pot

# ── Misc ──────────────────────────────────────────────────────────────────────
*.bak
*.tmp
*.orig
*.rej
patch/

# ── Project-specific scratch files ───────────────────────────────────────────
response.txt
frontend/intro.mp4
frontend/generate_intro.py
frontend/_check_dims.py
frontend/_patch_boot.py
frontend/_try_clip.py

# samconfig.toml contains AWS account IDs — exclude from public repos
sam-app/samconfig.toml
